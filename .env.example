# demo (default) simulates a Paystack M-Pesa approval and never charges a phone.
PAYMENTS_MODE=demo
PORT=3000

# Postgres is required for live mode on Vercel. Neon can inject DATABASE_URL.
# Without a database URL, the app uses its local JSON store.
DATABASE_URL=

# Live mode also requires persistent storage and a live Paystack secret key.
# Never expose this secret to the React app or commit it to git.
PAYSTACK_SECRET_KEY=

# Paid entry price in whole KES; defaults to 500. If temporarily changed,
# existing entries are still verified against their own stored amount.
ENTRY_PRICE_KES=500

# Optional isolated-demo presentation mode: every spin wins a Regular or VIP
# demo ticket. Ignored in live mode; never use for the real campaign.
DEMO_ALWAYS_WIN=false

# Protects the scheduled reconciliation endpoint. Generate a random secret of
# at least 32 characters; Vercel sends it as a Bearer token with cron requests.
CRON_SECRET=

# Optional invite-only checkout in demo or live mode. Use a long random code.
# The frontend accepts it in an #entry-access=... URL fragment.
ENTRY_ACCESS_CODE=

# Optional isolated campaign storage row for a private demo or live pilot.
# LIVE_ENTRY_ACCESS_CODE remains supported as a legacy alias for ENTRY_ACCESS_CODE.
CAMPAIGN_STORAGE_KEY=
LIVE_ENTRY_ACCESS_CODE=

# For a dedicated Paystack business, configure this public HTTPS webhook:
# https://your-public-domain.example/api/payments/paystack/webhook

# Optional shared-business setup: if another active project already receives
# this Paystack webhook, set its existing HTTPS receiver URL here and point the
# Paystack dashboard to /api/payments/paystack/router instead. The router
# forwards the unchanged raw body and signature before processing Detty events.
PAYSTACK_WEBHOOK_FORWARD_URL=
