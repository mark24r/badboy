# demo (default) simulates a Paystack M-Pesa approval and never charges a phone.
PAYMENTS_MODE=demo
PORT=3000

# Postgres is required for live mode on Vercel. Neon can inject DATABASE_URL.
# Without a database URL, the app uses its local JSON store.
DATABASE_URL=

# Live mode also requires persistent storage and a live Paystack secret key.
# Never expose this secret to the React app or commit it to git.
PAYSTACK_SECRET_KEY=

# Protects the scheduled reconciliation endpoint. Generate a random secret of
# at least 32 characters; Vercel sends it as a Bearer token with cron requests.
CRON_SECRET=

# In the Paystack dashboard, configure this public HTTPS webhook:
# https://your-public-domain.example/api/payments/paystack/webhook
