# demo (default) simulates STK Push and never charges a phone.
# live requires all Daraja values below and a public HTTPS callback URL.
PAYMENTS_MODE=demo
PORT=3000

# Safaricom Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/payments/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
